# ============================================================================
#  SPANDANA environment configuration (copy to .env.local / .env as needed)
# ============================================================================

# ---- Frontend (Next.js) ------------------------------------------------------
# FastAPI base URL. Without it the app measures the voltage criteria in-browser
# and reports that model output is unavailable; when it is set and reachable,
# AI screening and the measured evaluation metrics come from the backend.
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# ---- FastAPI backend (optional overrides — defaults live in config.json) -----
# SPANDANA_API_HOST=127.0.0.1
# SPANDANA_API_PORT=8000
# Extra origins allowed to call the API (comma-separated)
# SPANDANA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the trained model artefacts live (default: backend/models)
# SPANDANA_MODELS_DIR=

# ---- Training pipeline (optional overrides — defaults live in config.json) ---
# Where PTB-XL is extracted (default: data/ptbxl)
# SPANDANA_RAW_DIR=
# Where the project root is (only needed when launching from elsewhere)
# SPANDANA_PROJECT_ROOT=
